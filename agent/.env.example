# Copy to .env for a local run. Never commit .env.

# The products MCP endpoint: the MCP gateway URL plus /mcp in the cloud, or the local server.
PRODUCTS_MCP_URL=http://localhost:9090/mcp
# The MCP gateway's API key. Leave empty for the local server.
MCP_API_KEY=

# In Agent Manager, keep USE_LLM_PROVIDER=true and bind an Anthropic LLM provider, which injects
# LLM_PROVIDER_URL and LLM_PROVIDER_KEY. Local runs call Anthropic directly.
USE_LLM_PROVIDER=false
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
MAX_TOKENS=16000
STORE_NAME=Summit Outdoor
